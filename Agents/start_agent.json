{
  "id": "start",
  "name": "Стартовый агент",
  "description": "Определяет тип заметки пользователя и запускает соответсвующую цепочку агентов",
  "promtp:" "start_agent.prompt"
  "schema": "start_schema.prompt"

  "output": 
  {
    "saveAs": "clarification"
  },

  "conditions": [
    {
      "if": "NeedClarification == true",
      "next": "agents/send_questions.json"
    },
    {
      "if": "NeedClarification == false",
      "next": "agents/draft_memo.json"
    }
  ],

  "retry": {
    "count": 3,
    "delaySeconds": 10
  },


  "onError": "agents/error_handler.json"
}